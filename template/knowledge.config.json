{
  "company": {
    "name": "Example Company",
    "slug": "example",
    "language": "en"
  },
  "remote": "",
  "roster": {
    "you@example.com": "your-slug"
  },
  "departments": [
    "sales",
    "marketing",
    "product",
    "operations"
  ],
  "access": {
    "default": "owners",
    "paths": {
      "CONTEXT.md": "company",
      "now.md": "company",
      "concepts/": "company",
      "skills/": "company",
      "_templates/": "company",
      "projects/": "company",
      "people/": "company",
      "*-personal.md": "owners",
      "departments/": "department",
      "tasks/": "department",
      "meetings/": "owners",
      "journal/": "owners",
      "wiki/": "owners"
    },
    "writable": [
      "departments/<dept>/",
      "tasks/<dept>/",
      "journal/",
      "wiki/log/"
    ]
  },
  "conventions": {
    "frontmatterRequired": [
      "title",
      "slug",
      "category",
      "summary",
      "status"
    ],
    "statuses": [
      "draft",
      "stable"
    ]
  },
  "version": "0.32.0"
}
